<Window x:Class="LabelGenerator.Designer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Label Template Designer"
        Height="768"
        Width="1024"
        MinHeight="640"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        KeyDown="Window_KeyDown"
        FontFamily="Plus Jakarta Sans, Segoe UI"
        Background="#F3F3F3">
    <Window.Resources>
        <SolidColorBrush x:Key="PrecisionBlueBrush" Color="#0067C0" />
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#F8F8F8" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DADADA" />
        <SolidColorBrush x:Key="TextBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#616161" />

        <Style TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrecisionBlueBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrecisionBlueBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <DockPanel MinWidth="930">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Template Designer"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,18,0" />
                        <TextBlock Text="Template" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,8,0" />
                        <ComboBox x:Name="TemplateComboBox"
                                  DisplayMemberPath="DisplayName"
                                  Width="220"
                                  SelectionChanged="TemplateComboBox_SelectionChanged" />
                        <Button Content="New" Click="NewTemplateButton_Click" />
                        <Button Content="Copy as new" Click="CopyTemplateAsNewButton_Click" />
                        <Button Content="Delete" Click="DeleteTemplateButton_Click" />
                        <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock Text="Element type" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,8,0" />
                        <ComboBox x:Name="NewElementTypeComboBox"
                                  Width="125" />
                        <Button Content="New element" Style="{StaticResource PrimaryButtonStyle}" Click="NewElementButton_Click" />
                        <Button Content="Delete selected" Click="DeleteSelectedComponentButton_Click" />
                    </StackPanel>
                </DockPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="278" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="Template">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.ColumnSpan="2" Text="Id" />
                            <TextBox x:Name="TemplateIdTextBox" Grid.Row="1" Grid.ColumnSpan="2" />

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Name" />
                            <TextBox x:Name="TemplateNameTextBox" Grid.Row="3" Grid.ColumnSpan="2" />

                            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="Template file" />
                            <TextBox x:Name="TemplatePathTextBox" Grid.Row="5" Grid.ColumnSpan="2" />

                            <CheckBox x:Name="ShowBorderCheckBox"
                                      Grid.Row="6"
                                      Grid.ColumnSpan="2"
                                      Content="Show label border"
                                      Margin="0,2,0,8" />

                            <CheckBox x:Name="UseLabelCountCheckBox"
                                      Grid.Row="7"
                                      Grid.ColumnSpan="2"
                                      Content="Use LabelCount column"
                                      Margin="0,2,0,8" />

                            <TextBlock Grid.Row="8" Text="Count column" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="Max/item" Margin="6,0,0,0" />
                            <TextBox x:Name="LabelCountColumnTextBox" Grid.Row="9" />
                            <TextBox x:Name="MaxLabelCountTextBox" Grid.Row="9" Grid.Column="1" Margin="6,2,0,8" />

                            <TextBlock Grid.Row="10" Text="Label W mm" />
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="Label H mm" Margin="6,0,0,0" />
                            <TextBox x:Name="LabelWidthTextBox" Grid.Row="11" />
                            <TextBox x:Name="LabelHeightTextBox" Grid.Row="11" Grid.Column="1" Margin="6,2,0,8" />

                            <TextBlock Grid.Row="12" Text="Cols" />
                            <TextBlock Grid.Row="12" Grid.Column="1" Text="Rows" Margin="6,0,0,0" />
                            <TextBox x:Name="ColumnsTextBox" Grid.Row="13" />
                            <TextBox x:Name="RowsTextBox" Grid.Row="13" Grid.Column="1" Margin="6,2,0,8" />

                            <TextBlock Grid.Row="14" Text="Margin top mm" />
                            <TextBlock Grid.Row="14" Grid.Column="1" Text="Margin bottom mm" Margin="6,0,0,0" />
                            <TextBox x:Name="MarginTopTextBox" Grid.Row="15" />
                            <TextBox x:Name="MarginBottomTextBox" Grid.Row="15" Grid.Column="1" Margin="6,2,0,8" />

                            <TextBlock Grid.Row="16" Text="Margin left mm" />
                            <TextBlock Grid.Row="16" Grid.Column="1" Text="Margin right mm" Margin="6,0,0,0" />
                            <TextBox x:Name="MarginLeftTextBox" Grid.Row="17" />
                            <TextBox x:Name="MarginRightTextBox" Grid.Row="17" Grid.Column="1" Margin="6,2,0,8" />

                            <TextBlock Grid.Row="18" Text="Span H mm" />
                            <TextBlock Grid.Row="18" Grid.Column="1" Text="Span V mm" Margin="6,0,0,0" />
                            <TextBox x:Name="GapXTextBox" Grid.Row="19" />
                            <TextBox x:Name="GapYTextBox" Grid.Row="19" Grid.Column="1" Margin="6,2,0,8" />

                            <Button Grid.Row="20"
                                    Grid.ColumnSpan="2"
                                    Content="Apply template"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,6,0,0"
                                    Click="ApplyTemplateButton_Click" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Master view filters" Margin="0,12,0,0">
                        <DockPanel Margin="8">
                            <ListBox x:Name="MasterFiltersListBox"
                                     DockPanel.Dock="Top"
                                     DisplayMemberPath="DisplayName"
                                     MinHeight="110"
                                     MaxHeight="160"
                                     SelectionChanged="MasterFiltersListBox_SelectionChanged" />

                            <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.ColumnSpan="2" Text="Column" />
                                <ComboBox x:Name="MasterFilterColumnComboBox"
                                          Grid.Row="1"
                                          Grid.ColumnSpan="2"
                                          IsEditable="True" />

                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Regex" />
                                <TextBox x:Name="MasterFilterPatternTextBox"
                                         Grid.Row="3"
                                         Grid.ColumnSpan="2" />

                                <CheckBox x:Name="MasterFilterEnabledCheckBox"
                                          Grid.Row="4"
                                          Content="Enabled"
                                          IsChecked="True"
                                          Margin="0,0,0,8" />
                                <CheckBox x:Name="MasterFilterCaseCheckBox"
                                          Grid.Row="4"
                                          Grid.Column="1"
                                          Content="Case"
                                          Margin="6,0,0,8" />

                                <StackPanel Grid.Row="5"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal">
                                    <Button Content="Add" Width="58" Click="AddMasterFilterButton_Click" />
                                    <Button Content="Apply" Width="64" Click="ApplyMasterFilterButton_Click" />
                                    <Button Content="Delete" Width="72" Click="DeleteMasterFilterButton_Click" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Header="Elements" Margin="0,12,0,0">
                        <DockPanel Margin="8">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Up" Width="58" Click="MoveElementUpButton_Click" />
                                <Button Content="Down" Width="68" Click="MoveElementDownButton_Click" />
                                <Button Content="Delete" Width="72" Click="DeleteElementButton_Click" />
                            </StackPanel>
                            <ListBox x:Name="ElementsListBox"
                                     DisplayMemberPath="DisplayName"
                                     MinHeight="170"
                                     SelectionChanged="ElementsListBox_SelectionChanged" />
                        </DockPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2"
                    Background="#F8F8F8"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="10">
                        <TextBlock Text="Canvas"
                                   FontWeight="Bold"
                                   Margin="0,0,18,0" />
                        <TextBlock Text="Zoom" Foreground="{StaticResource MutedTextBrush}" />
                        <Slider x:Name="ZoomSlider"
                                Width="120"
                                Minimum="0.75"
                                Maximum="3"
                                Value="2"
                                TickFrequency="0.25"
                                Margin="8,0"
                                ValueChanged="ZoomSlider_ValueChanged" />
                        <TextBlock x:Name="CanvasSizeTextBlock" />
                    </StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="24">
                        <Canvas x:Name="DesignCanvas"
                                Background="White"
                                MouseLeftButtonDown="DesignCanvas_MouseLeftButtonDown" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <GroupBox Header="Selected element">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.ColumnSpan="2" Text="Type" />
                        <ComboBox x:Name="ElementTypeComboBox" Grid.Row="1" Grid.ColumnSpan="2" />

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Text" />
                        <TextBox x:Name="ElementTextTextBox" Grid.Row="3" Grid.ColumnSpan="2" />

                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="Field" />
                        <ComboBox x:Name="FieldNameComboBox"
                                  Grid.Row="5"
                                  Grid.ColumnSpan="2"
                                  IsEditable="True" />

                        <TextBlock Grid.Row="6" Text="X mm" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="Y mm" Margin="6,0,0,0" />
                        <TextBox x:Name="ElementXTextBox" Grid.Row="7" />
                        <TextBox x:Name="ElementYTextBox" Grid.Row="7" Grid.Column="1" Margin="6,2,0,8" />

                        <TextBlock Grid.Row="8" Text="Width mm" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="Height mm" Margin="6,0,0,0" />
                        <TextBox x:Name="ElementWidthTextBox" Grid.Row="9" />
                        <TextBox x:Name="ElementHeightTextBox" Grid.Row="9" Grid.Column="1" Margin="6,2,0,8" />

                        <TextBlock Grid.Row="10" Text="Font size" />
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="Align" Margin="6,0,0,0" />
                        <TextBox x:Name="FontSizeTextBox" Grid.Row="11" />
                        <ComboBox x:Name="TextAlignmentComboBox" Grid.Row="11" Grid.Column="1" Margin="6,2,0,8" />

                        <CheckBox x:Name="BoldCheckBox"
                                  Grid.Row="12"
                                  Content="Bold"
                                  Margin="0,0,0,8" />
                        <CheckBox x:Name="ItalicCheckBox"
                                  Grid.Row="12"
                                  Grid.Column="1"
                                  Content="Italic"
                                  Margin="6,0,0,8" />
                        <CheckBox x:Name="StrikethroughCheckBox"
                                  Grid.Row="13"
                                  Grid.ColumnSpan="2"
                                  Content="Strikethrough"
                                  Margin="0,0,0,8" />

                        <TextBlock Grid.Row="14" Text="Foreground" />
                        <TextBlock Grid.Row="14" Grid.Column="1" Text="Background" Margin="6,0,0,0" />
                        <TextBox x:Name="ForegroundTextBox" Grid.Row="15" />
                        <TextBox x:Name="BackgroundTextBox" Grid.Row="15" Grid.Column="1" Margin="6,2,0,8" />

                        <TextBlock Grid.Row="16" Text="Line thickness mm" />
                        <TextBlock Grid.Row="16" Grid.Column="1" Text="Style" Margin="6,0,0,0" />
                        <TextBox x:Name="LineThicknessTextBox" Grid.Row="17" />
                        <ComboBox x:Name="LineStyleComboBox" Grid.Row="17" Grid.Column="1" Margin="6,2,0,8" />

                        <TextBlock Grid.Row="18" Text="Barcode" />
                        <CheckBox x:Name="HumanReadableCheckBox"
                                  Grid.Row="18"
                                  Grid.Column="1"
                                  Content="Text"
                                  Margin="6,0,0,0" />
                        <ComboBox x:Name="BarcodeSymbologyComboBox" Grid.Row="19" Grid.ColumnSpan="2" />

                        <DockPanel Grid.Row="20" Grid.ColumnSpan="2" Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseImageButton_Click" />
                            <TextBox x:Name="ImagePathTextBox" Margin="0,2,6,0" />
                        </DockPanel>

                        <Button Grid.Row="21"
                                Grid.ColumnSpan="2"
                                Content="Apply element"
                                HorizontalAlignment="Stretch"
                                Margin="0,12,0,0"
                                Click="ApplyElementButton_Click" />
                    </Grid>
                </GroupBox>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <TextBlock x:Name="StatusTextBlock" Foreground="{StaticResource MutedTextBrush}" />
        </Border>
    </Grid>
</Window>
