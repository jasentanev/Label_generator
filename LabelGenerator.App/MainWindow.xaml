<Window x:Class="LabelGenerator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Label Generator"
        Height="820"
        Width="1280"
        MinHeight="680"
        MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        FontFamily="Plus Jakarta Sans, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DADADA" />
        <SolidColorBrush x:Key="TextBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#616161" />
        <SolidColorBrush x:Key="PrecisionBlueBrush" Color="#0067C0" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="CommandGroupTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrecisionBlueBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrecisionBlueBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EDEDED" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="ColumnHeaderHeight" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F3F3" />
            <Setter Property="Foreground" Value="#424242" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#5F6368" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#5F6368" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Label Generator"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,24,0" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Border Background="#EAF4EC"
                                BorderBrush="#B7DFC0"
                                BorderThickness="1"
                                Padding="10,4">
                            <TextBlock>
                                <Run Text="Selected: " />
                                <Run Text="{Binding SelectedPrimaryCount, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="#FAFAFA"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="Configuration &amp; loading"
                                       Style="{StaticResource CommandGroupTitleStyle}" />
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Data source"
                                           Style="{StaticResource LabelTextStyle}"
                                           Visibility="{Binding ShowDataSourceSelector, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ComboBox ItemsSource="{Binding DataSources}"
                                          SelectedItem="{Binding SelectedDataSource}"
                                          DisplayMemberPath="DisplayName"
                                          Width="240"
                                          Visibility="{Binding ShowDataSourceSelector, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="Configure"
                                        Visibility="{Binding ShowConfigureButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Click="ConfigureDataSourcesButton_Click" />
                                <Button Content="Load view"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding LoadPrimaryCommand}" />

                                <TextBlock Text="Template"
                                           Style="{StaticResource LabelTextStyle}"
                                           Margin="16,8,6,0"
                                           Visibility="{Binding ShowTemplateSelector, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ComboBox ItemsSource="{Binding Templates}"
                                          SelectedItem="{Binding SelectedTemplate}"
                                          DisplayMemberPath="DisplayName"
                                          Width="240"
                                          Margin="0,8,10,0"
                                          Visibility="{Binding ShowTemplateSelector, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="Designer"
                                        Margin="0,8,6,0"
                                        Visibility="{Binding ShowDesignerButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding OpenDesignerCommand}" />

                                <TextBlock Text="Printer"
                                           Style="{StaticResource LabelTextStyle}"
                                           Margin="16,8,6,0" />
                                <ComboBox ItemsSource="{Binding Printers}"
                                          SelectedItem="{Binding SelectedPrinter}"
                                          Width="220"
                                          Margin="0,8,10,0" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="#FAFAFA"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="Daily use"
                                       Style="{StaticResource CommandGroupTitleStyle}" />
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Scan"
                                           Style="{StaticResource LabelTextStyle}" />
                                <TextBox x:Name="ScanTextBox"
                                         Width="240"
                                         KeyDown="ScanTextBox_KeyDown" />
                                <Button Content="Mark"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="MarkScanButton_Click" />
                                <Button Content="Mark &amp; Print"
                                        Click="QuickMarkPrintButton_Click" />

                                <TextBlock Text="Copies"
                                           Style="{StaticResource LabelTextStyle}"
                                           Margin="16,8,6,0" />
                                <TextBox Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}"
                                         Width="58"
                                         Margin="0,8,10,0" />
                                <TextBlock Text="Start"
                                           Style="{StaticResource LabelTextStyle}"
                                           Margin="8,8,6,0" />
                                <TextBox Text="{Binding StartLabelPosition, UpdateSourceTrigger=PropertyChanged}"
                                         Width="58"
                                         Margin="0,8,10,0" />
                                <Button Content="Preview"
                                        Margin="12,8,6,0"
                                        Command="{Binding PreviewCommand}" />
                                <Button Content="Print"
                                        Margin="0,8,6,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding PrintCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Primary view">
                <DataGrid x:Name="PrimaryDataGrid"
                          ItemsSource="{Binding PrimaryRowsView}"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          SelectionChanged="PrimaryDataGrid_SelectionChanged" />
            </GroupBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox Header="Regex filters">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <Button Content="Apply filters"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ApplyFiltersCommand}" />
                            <Button Content="Clear filters"
                                    Command="{Binding ClearFiltersCommand}" />
                            <Button Content="Load details"
                                    Command="{Binding LoadDetailsCommand}" />
                            <Button Content="Only selected"
                                    Click="OnlySelectedButton_Click" />
                            <Button Content="Show filtered"
                                    Click="ShowFilteredRowsButton_Click" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Filters}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="On"
                                                        Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="44" />
                                <DataGridTextColumn Header="Column"
                                                    Binding="{Binding ColumnName}"
                                                    IsReadOnly="True"
                                                    Width="150" />
                                <DataGridTextColumn Header="Regex pattern"
                                                    Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*" />
                                <DataGridCheckBoxColumn Header="Case"
                                                        Binding="{Binding IsCaseSensitive, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="54" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>

                <Expander Grid.Row="2"
                          Header="Detail debug view"
                          IsExpanded="False"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrushSoft}"
                          BorderThickness="1"
                          Padding="8">
                    <DataGrid ItemsSource="{Binding DetailRowsView}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              Height="230" />
                </Expander>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource MutedTextBrush}" />
        </Border>
    </Grid>
</Window>
