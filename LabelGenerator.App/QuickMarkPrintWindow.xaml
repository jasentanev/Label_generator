<Window x:Class="LabelGenerator.App.QuickMarkPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Mark &amp; Print"
        Height="430"
        Width="620"
        MinHeight="390"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="Plus Jakarta Sans, Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DADADA" />
        <SolidColorBrush x:Key="TextBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#616161" />
        <SolidColorBrush x:Key="PrecisionBlueBrush" Color="#0067C0" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrecisionBlueBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrecisionBlueBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <StackPanel>
                <TextBlock Text="Quick Mark &amp; Print"
                           FontSize="20"
                           FontWeight="Bold" />
                <TextBlock Text="Scan code, load detail rows, and print immediately."
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ScanTextBox"
                             Height="48"
                             FontSize="22"
                             FontWeight="SemiBold"
                             VerticalContentAlignment="Center"
                             Padding="12,0"
                             BorderBrush="{StaticResource BorderBrushSoft}"
                             KeyDown="ScanTextBox_KeyDown" />
                    <Button x:Name="ScanButton"
                            Grid.Column="2"
                            Content="Scan &amp; print"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="48"
                            MinWidth="132"
                            Click="ScanButton_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Data source" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding SelectedDataSource.DisplayName, TargetNullValue='No data source'}"
                                   Margin="0,4,16,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Template" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding SelectedTemplate.DisplayName, TargetNullValue='No template'}"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Printer" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="{Binding SelectedPrinter, TargetNullValue='Default printer'}"
                                   Margin="0,4,16,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="Quantity policy" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Text="Copies fixed to 1; LabelCount is respected."
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="Key(s)" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock x:Name="KeysTextBlock"
                                   Text="-"
                                   Style="{StaticResource MetricValueStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="Detail rows" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock x:Name="DetailRowsTextBlock"
                                   Text="0"
                                   Style="{StaticResource MetricValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="Labels" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock x:Name="LabelsTextBlock"
                                   Text="0"
                                   Style="{StaticResource MetricValueStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusTextBlock"
                           Text="Ready to scan."
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,16,0" />
                <Button Grid.Column="1"
                        Content="Close"
                        IsCancel="True"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
