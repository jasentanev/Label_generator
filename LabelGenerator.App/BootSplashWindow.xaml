<Window x:Class="LabelGenerator.App.BootSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starting Label Generator"
        Width="520"
        Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        Background="#FFFFFF"
        FontFamily="Plus Jakarta Sans, Segoe UI">
    <Border BorderBrush="#DADADA"
            BorderThickness="1"
            Padding="22"
            Background="#FFFFFF">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image x:Name="LogoImage"
                   Stretch="Uniform"
                   MaxHeight="210"
                   Margin="0,0,0,18" />

            <TextBlock x:Name="InfoTextBlock"
                       Grid.Row="1"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#1F1F1F" />
        </Grid>
    </Border>
</Window>
