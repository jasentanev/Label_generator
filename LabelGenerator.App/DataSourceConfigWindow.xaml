<Window x:Class="LabelGenerator.App.DataSourceConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data source configuration"
        Height="760"
        Width="1160"
        MinHeight="660"
        MinWidth="980"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="Data sources">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            Margin="0,8,0,0">
                    <Button Content="New" Width="60" Click="NewButton_Click" />
                    <Button Content="ODBC" Width="68" Click="NewOdbcButton_Click" />
                    <Button Content="Delete" Width="72" Click="DeleteButton_Click" />
                </StackPanel>
                <ListBox x:Name="DataSourcesListBox"
                         DisplayMemberPath="DisplayName"
                         SelectionChanged="DataSourcesListBox_SelectionChanged" />
            </DockPanel>
        </GroupBox>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Id" />
                <TextBox x:Name="IdTextBox" Grid.Row="1" />

                <TextBlock Grid.Column="2" Text="Name" />
                <TextBox x:Name="DisplayNameTextBox" Grid.Row="1" Grid.Column="2" />

                <TextBlock Grid.Row="2" Text="Provider" />
                <ComboBox x:Name="ProviderComboBox"
                          Grid.Row="3"
                          IsEditable="True" />

                <TextBlock Grid.Row="2" Grid.Column="2" Text="Key column" />
                <TextBox x:Name="KeyColumnTextBox" Grid.Row="3" Grid.Column="2" />

                <TextBlock Grid.Row="4" Text="Max rows" />
                <TextBox x:Name="MaxRowsTextBox" Grid.Row="5" />

                <TextBlock Grid.Row="4" Grid.Column="2" Text="Timeout seconds" />
                <TextBox x:Name="TimeoutTextBox" Grid.Row="5" Grid.Column="2" />

                <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Text="Connection string" />
                <TextBox x:Name="ConnectionStringTextBox"
                         Grid.Row="7"
                         Grid.ColumnSpan="3"
                         Height="72"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Grid.Row="8" Text="Primary view" />
                <TextBox x:Name="PrimaryViewTextBox" Grid.Row="9" />

                <TextBlock Grid.Row="8" Grid.Column="2" Text="Detail view" />
                <TextBox x:Name="DetailViewTextBox" Grid.Row="9" Grid.Column="2" />

                <TextBlock Grid.Row="10" Text="Primary SELECT" />
                <TextBox x:Name="PrimarySqlTextBox"
                         Grid.Row="11"
                         Height="110"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />

                <TextBlock Grid.Row="10" Grid.Column="2" Text="Detail SELECT" />
                <TextBox x:Name="DetailSqlTextBox"
                         Grid.Row="11"
                         Grid.Column="2"
                         Height="110"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />

                <TextBlock Grid.Row="12" Grid.ColumnSpan="3" Text="Visible columns" />
                <TextBox x:Name="VisibleColumnsTextBox"
                         Grid.Row="13"
                         Grid.ColumnSpan="3"
                         Height="90"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Grid.Row="14" Text="Lookup key column" />
                <TextBox x:Name="LookupKeyColumnTextBox" Grid.Row="15" />

                <TextBlock Grid.Row="14" Grid.Column="2" Text="Test scan value" />
                <TextBox x:Name="LookupTestValueTextBox" Grid.Row="15" Grid.Column="2" />

                <TextBlock Grid.Row="16" Grid.ColumnSpan="3" Text="Lookup SELECT ({Scan} is the scanned value)" />
                <TextBox x:Name="LookupSqlTextBox"
                         Grid.Row="17"
                         Grid.ColumnSpan="3"
                         Height="90"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />

                <StackPanel Grid.Row="18"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">
                    <Button Content="Apply" Width="76" Click="ApplyButton_Click" />
                    <Button Content="Test primary" Width="105" Click="TestPrimaryButton_Click" />
                    <Button Content="Test lookup" Width="105" Click="TestLookupButton_Click" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1"
                Grid.ColumnSpan="3"
                BorderBrush="#D0D7DE"
                BorderThickness="0,1,0,0"
                Padding="0,10,0,0"
                Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Save" Width="76" Click="SaveButton_Click" />
                    <Button Content="Cancel" Width="76" Click="CancelButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
