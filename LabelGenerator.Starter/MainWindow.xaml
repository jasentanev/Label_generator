<Window x:Class="LabelGenerator.Starter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Label Starter"
        Height="760"
        Width="1120"
        MinHeight="640"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="Plus Jakarta Sans, Segoe UI"
        Background="#F3F3F3">
    <Window.Resources>
        <SolidColorBrush x:Key="PrecisionBlueBrush" Color="#0067C0" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DADADA" />
        <SolidColorBrush x:Key="TextBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#616161" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrecisionBlueBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrecisionBlueBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Background="#FAFAFA"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        Padding="8">
                    <Image x:Name="LogoImage"
                           Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Label Starter"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,0,0,8" />
                    <TextBlock x:Name="InfoTextBlock"
                               Text="Choose a prepared label workflow."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button Content="Reload"
                            Click="ReloadButton_Click" />
                    <Button Content="Config"
                            Click="ConfigButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.05*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Prepared label workflows">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Margin="0,10,0,0">
                        <Button Content="Open selected"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OpenSelectedButton_Click" />
                        <Button Content="Config"
                                Click="ConfigButton_Click" />
                    </StackPanel>

                    <ListBox x:Name="ProfilesListBox"
                             SelectionChanged="ProfilesListBox_SelectionChanged"
                             BorderBrush="{StaticResource BorderBrushSoft}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10"
                                        Margin="0,0,0,8"
                                        BorderBrush="#E5E5E5"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="15"
                                                   FontWeight="Bold" />
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Description}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Summary}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Margin="0,6,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Label preview">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock x:Name="PreviewTitleTextBlock"
                                   Text="No label selected"
                                   FontSize="16"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="PreviewSummaryTextBlock"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#FAFAFA"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            Padding="18">
                        <Viewbox Stretch="Uniform">
                            <Canvas x:Name="PreviewCanvas"
                                    Width="420"
                                    Height="260"
                                    Background="White" />
                        </Viewbox>
                    </Border>

                    <TextBox x:Name="CommandPreviewTextBox"
                             Grid.Row="2"
                             IsReadOnly="True"
                             Height="30"
                             Margin="0,10,0,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource BorderBrushSoft}" />
                </Grid>
            </GroupBox>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="{StaticResource MutedTextBrush}" />
        </Border>
    </Grid>
</Window>
