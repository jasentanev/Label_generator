<Window x:Class="LabelGenerator.Starter.StarterConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Label Starter Configuration"
        Height="700"
        Width="920"
        MinHeight="600"
        MinWidth="840"
        WindowStartupLocation="CenterOwner"
        FontFamily="Plus Jakarta Sans, Segoe UI"
        Background="#F3F3F3">
    <Window.Resources>
        <SolidColorBrush x:Key="PrecisionBlueBrush" Color="#0067C0" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DADADA" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#616161" />

        <Style TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrecisionBlueBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrecisionBlueBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="Starter profiles">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            Margin="0,10,0,0">
                    <Button Content="New"
                            Width="68"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="NewProfileButton_Click" />
                    <Button Content="Delete"
                            Width="78"
                            Click="DeleteProfileButton_Click" />
                </StackPanel>
                <ListBox x:Name="ProfilesListBox"
                         DisplayMemberPath="DisplayName"
                         SelectionChanged="ProfilesListBox_SelectionChanged" />
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Column="2" Header="Profile settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Name" />
                    <TextBox x:Name="NameTextBox" Grid.Row="1" Grid.ColumnSpan="3" />

                    <TextBlock Grid.Row="2" Text="Description" />
                    <TextBox x:Name="DescriptionTextBox"
                             Grid.Row="3"
                             Grid.ColumnSpan="3"
                             Height="80"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />

                    <TextBlock Grid.Row="4" Text="Datasource" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Label" />
                    <ComboBox x:Name="DataSourceComboBox"
                              Grid.Row="5"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id" />
                    <ComboBox x:Name="LabelComboBox"
                              Grid.Row="5"
                              Grid.Column="2"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id" />

                    <TextBlock Grid.Row="6" Text="Action" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="Mode" />
                    <ComboBox x:Name="ActionComboBox" Grid.Row="7" />
                    <StackPanel Grid.Row="7" Grid.Column="2">
                        <CheckBox x:Name="UsersCheckBox"
                                  Content="Users"
                                  IsChecked="True"
                                  Margin="0,2,0,6" />
                        <CheckBox x:Name="EnabledCheckBox"
                                  Content="Enabled"
                                  IsChecked="True" />
                    </StackPanel>

                    <TextBlock Grid.Row="8"
                               Grid.ColumnSpan="3"
                               Text="Command line preview"
                               Margin="0,12,0,0" />
                    <TextBox x:Name="CommandPreviewTextBox"
                             Grid.Row="9"
                             Grid.ColumnSpan="3"
                             IsReadOnly="True" />

                    <StackPanel Grid.Row="10"
                                Grid.ColumnSpan="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <Button Content="Apply"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ApplyProfileButton_Click" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </GroupBox>

        <Border Grid.Row="1"
                Grid.ColumnSpan="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0"
                Padding="0,10,0,0"
                Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Save"
                            Width="76"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveButton_Click" />
                    <Button Content="Cancel"
                            Width="76"
                            IsCancel="True"
                            Click="CancelButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusTextBlock"
                           Foreground="{StaticResource MutedTextBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
